{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug N-Ray",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Debug/PathTracingRenderer",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/PathTracingRenderer",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build Debug",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Use Intel disassembly syntax",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Run Release",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Release/PathTracingRenderer",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/PathTracingRenderer",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build Release"
        }
    ]
}
