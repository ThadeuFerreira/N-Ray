#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) buffer PixelBuffer {
	uint pixels[];
};

struct GpuSettings {
	vec4 renderParams;
	vec4 skyParams;
	vec4 sunDir;
	vec4 sunColor;
	vec4 shadowParams;
	vec4 shadowBasisX;
	vec4 shadowBasisY;
	vec4 shadowBasisZ;
	vec4 shadowBounds;
	vec4 shadowDepth;
	vec4 denoiseParams;
	uvec4 denoiseFlags;
};

layout(std430, binding = 6) readonly buffer SettingsBuffer {
	GpuSettings cfg;
};

layout(rgba32f, binding = 9) uniform image2D resolvedHdrImage;
layout(rgba16f, binding = 10) uniform image2D normalRoughnessImage;
layout(rgba16f, binding = 11) uniform image2D albedoMetallicImage;
layout(r32f, binding = 12) uniform image2D depthImage;
layout(r32ui, binding = 13) uniform uimage2D materialIdImage;
layout(r32ui, binding = 14) uniform uimage2D instanceIdImage;
layout(rgba16f, binding = 15) uniform image2D denoisePingImage;
layout(rgba16f, binding = 16) uniform image2D denoisePongImage;

layout(push_constant) uniform PushConstants {
	int width;
	int height;
	float time;
	uint sampleIndex;
	vec4 cameraPos;
	vec4 cameraForward;
	vec4 cameraRight;
	vec4 cameraUp;
	vec4 cameraParams;
	uvec4 sceneCounts;
	uvec4 denoisePass;
} pc;

const uint DENOISER_MODE_OFF = 0u;
const uint DEBUG_FINAL = 0u;
const uint DEBUG_RAW = 1u;
const uint DEBUG_DENOISED = 2u;
const uint DEBUG_NORMAL = 3u;
const uint DEBUG_ALBEDO = 4u;
const uint DEBUG_DEPTH = 5u;
const uint DEBUG_MATERIAL_ID = 6u;
const uint DEBUG_INSTANCE_ID = 7u;
const uint INVALID_ID = 0xffffffffu;

bool invalidVec3(vec3 value) {
	return any(isnan(value)) || any(isinf(value));
}

float contrastCurve(float v, float c) {
	v = clamp(v, 0.0, 1.0);
	if (v < 0.5) {
		return 0.5 * pow(2.0 * v, 1.0 + c);
	}
	return 1.0 - 0.5 * pow(2.0 * (1.0 - v), 1.0 + c);
}

vec3 contrastSCurve(vec3 color, float c) {
	return clamp(vec3(
		contrastCurve(color.r, c),
		contrastCurve(color.g, c),
		contrastCurve(color.b, c)
	), 0.0, 1.0);
}

uint packRgba(vec3 color) {
	if (invalidVec3(color)) {
		color = vec3(1.0, 0.0, 1.0);
	}
	uvec3 rgb = uvec3(clamp(color, 0.0, 1.0) * 255.0 + 0.5);
	return rgb.r | (rgb.g << 8) | (rgb.b << 16) | (255u << 24);
}

uint hashId(uint value) {
	value ^= value >> 16u;
	value *= 0x7feb352du;
	value ^= value >> 15u;
	value *= 0x846ca68bu;
	value ^= value >> 16u;
	return value;
}

vec3 idColor(uint id) {
	if (id == INVALID_ID) {
		return vec3(0.0);
	}
	uint h = hashId(id + 1u);
	return vec3(
		float(h & 255u),
		float((h >> 8u) & 255u),
		float((h >> 16u) & 255u)
	) * (1.0 / 255.0);
}

vec3 loadDenoised(ivec2 pixel, vec3 rawColor) {
	if (pc.denoisePass.x == 0u || cfg.denoiseFlags.x == DENOISER_MODE_OFF) {
		return rawColor;
	}
	if ((pc.denoisePass.x & 1u) == 1u) {
		return imageLoad(denoisePongImage, pixel).rgb;
	}
	return imageLoad(denoisePingImage, pixel).rgb;
}

vec3 toneMapHdr(vec3 color) {
	color = max(color, vec3(0.0));
	color *= cfg.renderParams.w;
	color = clamp(color, 0.0, 1.0);
	color = contrastSCurve(color, cfg.skyParams.w);
	return pow(max(color, vec3(0.0)), vec3(1.0 / 2.2));
}

vec3 displayDebugColor(ivec2 pixel, uint debugView, vec3 rawColor, vec3 denoisedColor, out bool hdrOutput) {
	hdrOutput = false;
	if (debugView == DEBUG_RAW) {
		hdrOutput = true;
		return rawColor;
	}
	if (debugView == DEBUG_DENOISED) {
		hdrOutput = true;
		return denoisedColor;
	}
	if (debugView == DEBUG_NORMAL) {
		uint materialId = imageLoad(materialIdImage, pixel).r;
		if (materialId == INVALID_ID) {
			return vec3(0.0);
		}
		vec3 normal = normalize(imageLoad(normalRoughnessImage, pixel).xyz);
		return normal * 0.5 + 0.5;
	}
	if (debugView == DEBUG_ALBEDO) {
		vec3 albedo = clamp(imageLoad(albedoMetallicImage, pixel).rgb, 0.0, 1.0);
		return pow(albedo, vec3(1.0 / 2.2));
	}
	if (debugView == DEBUG_DEPTH) {
		uint materialId = imageLoad(materialIdImage, pixel).r;
		if (materialId == INVALID_ID) {
			return vec3(0.0);
		}
		float depth = max(imageLoad(depthImage, pixel).r, 0.0);
		float mapped = depth / (depth + 10.0);
		return vec3(mapped);
	}
	if (debugView == DEBUG_MATERIAL_ID) {
		return idColor(imageLoad(materialIdImage, pixel).r);
	}
	if (debugView == DEBUG_INSTANCE_ID) {
		return idColor(imageLoad(instanceIdImage, pixel).r);
	}

	hdrOutput = true;
	float strength = clamp(cfg.denoiseParams.x, 0.0, 1.0);
	return mix(rawColor, denoisedColor, strength);
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= pc.width || pixel.y >= pc.height) {
		return;
	}

	uint pixelIndex = uint(pixel.y * pc.width + pixel.x);
	vec3 rawColor = max(imageLoad(resolvedHdrImage, pixel).rgb, vec3(0.0));
	vec3 denoisedColor = max(loadDenoised(pixel, rawColor), vec3(0.0));
	uint debugView = cfg.denoiseFlags.x == DENOISER_MODE_OFF ? DEBUG_FINAL : cfg.denoiseFlags.y;

	bool hdrOutput;
	vec3 color = displayDebugColor(pixel, debugView, rawColor, denoisedColor, hdrOutput);
	if (hdrOutput) {
		color = toneMapHdr(color);
	}

	pixels[pixelIndex] = packRgba(color);
}
