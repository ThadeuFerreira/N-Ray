#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Specialization constant 0: overridden at pipeline creation (32 on Intel Iris Xe, 64 otherwise).
layout(constant_id = 0) const int BVH_MAX_STACK_DEPTH = 64;

layout(std430, binding = 0) buffer PixelBuffer {
	uint pixels[];
};

struct GpuTriIntersect {
	vec4 a;
	vec4 eA;
	vec4 eB;
	uvec4 ids;
};

struct GpuTriShading {
	vec4 aN;
	vec4 bN;
	vec4 cN;
	vec4 aTangent;
	vec4 bTangent;
	vec4 cTangent;
	vec4 uv01;
	vec4 uv2;
	uvec4 ids;
};

struct GpuMaterial {
	vec4 baseColor;
	vec4 params;
	vec4 emissionIor;
	uvec4 textureIndices;
	uvec4 textureInfo;
	vec4 textureParams;
	vec4 attenuation;
	uvec4 volumeTextureInfo;
};

struct GpuBvhNode {
	vec4 minBounds;
	vec4 maxBounds;
	uvec4 meta;
};

struct GpuSettings {
	vec4 renderParams;
	vec4 skyParams;
	vec4 sunDir;
	vec4 sunColor;
	vec4 shadowParams;
	vec4 shadowBasisX;
	vec4 shadowBasisY;
	vec4 shadowBasisZ;
	vec4 shadowBounds;
	vec4 shadowDepth;
	vec4 denoiseParams;
	uvec4 denoiseFlags;
};

layout(std430, binding = 1) readonly buffer TriIntersectBuffer {
	GpuTriIntersect triIsect[];
};

layout(std430, binding = 2) readonly buffer TriShadingBuffer {
	GpuTriShading triShading[];
};

layout(std430, binding = 3) readonly buffer MaterialBuffer {
	GpuMaterial materials[];
};

layout(std430, binding = 4) readonly buffer BvhBuffer {
	GpuBvhNode bvhNodes[];
};

layout(std430, binding = 5) buffer AccumBuffer {
	vec4 accum[];
};

layout(std430, binding = 6) readonly buffer SettingsBuffer {
	GpuSettings cfg;
};

layout(binding = 7) uniform sampler2D sceneTextures[256];

layout(std430, binding = 8) readonly buffer ShadowMapBuffer {
	uint shadowMap[];
};

layout(rgba32f, binding = 9) uniform image2D resolvedHdrImage;
layout(rgba16f, binding = 10) uniform image2D normalRoughnessImage;
layout(rgba16f, binding = 11) uniform image2D albedoMetallicImage;
layout(r32f, binding = 12) uniform image2D depthImage;
layout(r32ui, binding = 13) uniform uimage2D materialIdImage;
layout(r32ui, binding = 14) uniform uimage2D instanceIdImage;
layout(rgba16f, binding = 15) uniform image2D denoisePingImage;
layout(rgba16f, binding = 16) uniform image2D denoisePongImage;

layout(push_constant) uniform PushConstants {
	int width;
	int height;
	float time;
	uint sampleIndex;
	vec4 cameraPos;
	vec4 cameraForward;
	vec4 cameraRight;
	vec4 cameraUp;
	vec4 cameraParams;
	uvec4 sceneCounts;
	uvec4 denoisePass;
} pc;

const float PI = 3.14159265358979323846;
const float EPSILON = 0.0000001;
const float MIN_DET_EPSILON = 0.000000000001;
const float MIN_RAY_BIAS = 0.000001;
const float INF_T = 3.402823466e+38;
const uint INVALID_TEXTURE = 0xffffffffu;
const uint GLTF_ALPHA_OPAQUE = 0u;
const uint GLTF_ALPHA_MASK = 1u;
const uint GLTF_ALPHA_BLEND = 2u;
const uint MATERIAL_OPAQUE_DIELECTRIC = 0u;
const uint MATERIAL_OPAQUE_METAL = 1u;
const uint MATERIAL_ALPHA_MASK = 2u;
const uint MATERIAL_ALPHA_BLEND_COVERAGE = 3u;
const uint MATERIAL_THIN_TRANSMISSION = 4u;
const uint MATERIAL_VOLUME_TRANSMISSION = 5u;
const uint MATERIAL_UNLIT = 6u;
const uint MATERIAL_CAR_PAINT = 7u;
const uint MATERIAL_RUBBER = 8u;
const uint MATERIAL_EMISSIVE = 9u;
const uint SHADOW_MODE_NONE = 0u;
const uint SHADOW_MODE_RAY_TRACED = 1u;
const uint SHADOW_MODE_SHADOW_MAP = 2u;
const uint SHADOW_MAP_EMPTY = 0xffffffffu;
const uint INVALID_ID = 0xffffffffu;

bool invalidVec3(vec3 value) {
	return any(isnan(value)) || any(isinf(value));
}

vec3 safeNormalize(vec3 value, vec3 fallback) {
	float lenSq = dot(value, value);
	if (invalidVec3(value) || !(lenSq > 0.00000001)) {
		return fallback;
	}
	return normalize(value);
}

float maxComponent(vec3 value) {
	return max(value.x, max(value.y, value.z));
}

uint packRgba(vec3 color) {
	if (invalidVec3(color)) {
		color = vec3(1.0, 0.0, 1.0);
	}
	uvec3 rgb = uvec3(clamp(color, 0.0, 1.0) * 255.0 + 0.5);
	return rgb.r | (rgb.g << 8) | (rgb.b << 16) | (255u << 24);
}

uint pcgHash(uint inputValue) {
	uint state = inputValue * 747796405u + 2891336453u;
	uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}

uint seedRng(uint pixelIndex, uint sampleIndex) {
	return pcgHash(pixelIndex ^ pcgHash(sampleIndex + 0x9E3779B9u));
}

uint rngU32(inout uint state) {
	state = state * 747796405u + 2891336453u;
	uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}

float rngFloat(inout uint state) {
	return float(rngU32(state) >> 8u) * (1.0 / 16777216.0);
}

vec3 sampleCosineHemisphere(vec3 normal, vec3 faceNormal, float u1, float u2) {
	float r = sqrt(max(u1, 0.0));
	float phi = 2.0 * PI * u2;
	vec3 localDir = vec3(
		r * cos(phi),
		r * sin(phi),
		sqrt(max(1.0 - u1, 0.0))
	);

	vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
	vec3 tangent = safeNormalize(cross(up, normal), vec3(1.0, 0.0, 0.0));
	vec3 bitangent = cross(normal, tangent);
	vec3 worldDir = safeNormalize(
		localDir.x * tangent +
		localDir.y * bitangent +
		localDir.z * normal,
		normal
	);

	if (dot(worldDir, faceNormal) < 0.0) {
		worldDir = -worldDir;
	}
	return worldDir;
}

vec3 sampleGGX(vec3 normal, float roughness, float r1, float r2) {
	float a = roughness * roughness;
	float theta = atan(a * sqrt(max(r1, 0.0)) / sqrt(max(1.0 - r1, 0.000001)));
	float phi = 2.0 * PI * r2;

	vec3 h = vec3(
		sin(theta) * cos(phi),
		sin(theta) * sin(phi),
		cos(theta)
	);

	vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
	vec3 tangent = safeNormalize(cross(up, normal), vec3(1.0, 0.0, 0.0));
	vec3 bitangent = cross(normal, tangent);
	return safeNormalize(tangent * h.x + bitangent * h.y + normal * h.z, normal);
}

vec3 sky(vec3 dir) {
	vec3 skyCol = vec3(cfg.skyParams.x);

	if (cfg.skyParams.y > 0.5) {
		vec3 worldUp = vec3(0.0, 0.0, 1.0);
		vec3 skyTop = vec3(0.263, 0.553, 0.769);
		vec3 skyBase = vec3(0.89, 0.824, 0.698);
		float upAmount = pow(max(dot(dir, worldUp), 0.0), 0.5);
		skyCol = mix(skyBase, skyTop, upAmount) * cfg.skyParams.x;
	}

	if (cfg.skyParams.z > 0.5) {
		vec3 sunDirection = safeNormalize(cfg.sunDir.xyz, vec3(0.0, 0.0, 1.0));
		float sunDot = clamp(dot(dir, sunDirection), -1.0, 1.0);
		float sunAngle = degrees(acos(sunDot));
		if (sunAngle < cfg.sunDir.w) {
			skyCol = cfg.sunColor.rgb * cfg.sunColor.w;
		}
	}

	return skyCol;
}

float contrastCurve(float v, float c) {
	v = clamp(v, 0.0, 1.0);
	if (v < 0.5) {
		return 0.5 * pow(2.0 * v, 1.0 + c);
	}
	return 1.0 - 0.5 * pow(2.0 * (1.0 - v), 1.0 + c);
}

vec3 contrastSCurve(vec3 color, float c) {
	return clamp(vec3(
		contrastCurve(color.r, c),
		contrastCurve(color.g, c),
		contrastCurve(color.b, c)
	), 0.0, 1.0);
}

vec3 srgbToLinear(vec3 color) {
	vec3 low = color / 12.92;
	vec3 high = pow(max((color + 0.055) / 1.055, vec3(0.0)), vec3(2.4));
	return mix(low, high, step(vec3(0.04045), color));
}

bool validTexture(uint textureIndex) {
	return textureIndex != INVALID_TEXTURE && textureIndex < pc.sceneCounts.w;
}

vec4 sampleSceneTexture(uint textureIndex, vec2 uv, vec4 fallback) {
	if (!validTexture(textureIndex)) {
		return fallback;
	}
	return textureLod(sceneTextures[nonuniformEXT(textureIndex)], uv, 0.0);
}

vec2 interpolateUv(GpuTriShading shading, float hitU, float hitV) {
	float hitW = 1.0 - hitU - hitV;
	vec2 aUv = shading.uv01.xy;
	vec2 bUv = shading.uv01.zw;
	vec2 cUv = shading.uv2.xy;
	return aUv * hitW + bUv * hitU + cUv * hitV;
}

vec4 interpolateTangent(GpuTriShading shading, float hitU, float hitV) {
	float hitW = 1.0 - hitU - hitV;
	vec4 tangent =
		shading.aTangent * hitW +
		shading.bTangent * hitU +
		shading.cTangent * hitV;
	tangent.w = tangent.w < 0.0 ? -1.0 : 1.0;
	return tangent;
}

float materialAlpha(GpuMaterial material, vec2 uv) {
	float alpha = material.baseColor.a;
	if (validTexture(material.textureIndices.x)) {
		alpha *= sampleSceneTexture(material.textureIndices.x, uv, vec4(1.0)).a;
	}
	return alpha;
}

float materialTransmissionStrength(GpuMaterial material, vec2 uv) {
	uint materialKind = material.textureInfo.w;
	if (materialKind != MATERIAL_THIN_TRANSMISSION && materialKind != MATERIAL_VOLUME_TRANSMISSION) {
		return 0.0;
	}

	float transmission = clamp(material.params.w, 0.0, 1.0);
	if (validTexture(material.textureInfo.z)) {
		transmission *= clamp(sampleSceneTexture(material.textureInfo.z, uv, vec4(1.0)).r, 0.0, 1.0);
	}
	return transmission;
}

bool materialIsTransmission(GpuMaterial material) {
	uint materialKind = material.textureInfo.w;
	return materialKind == MATERIAL_THIN_TRANSMISSION || materialKind == MATERIAL_VOLUME_TRANSMISSION;
}

bool materialIsThinTransmission(GpuMaterial material) {
	return material.textureInfo.w == MATERIAL_THIN_TRANSMISSION;
}

bool materialIsVolumeTransmission(GpuMaterial material) {
	return material.textureInfo.w == MATERIAL_VOLUME_TRANSMISSION;
}

float materialVolumeThickness(GpuMaterial material, vec2 uv) {
	if (!materialIsVolumeTransmission(material)) {
		return 0.0;
	}

	float thickness = max(material.textureParams.w, 0.0);
	if (validTexture(material.volumeTextureInfo.x)) {
		thickness *= clamp(sampleSceneTexture(material.volumeTextureInfo.x, uv, vec4(1.0)).g, 0.0, 1.0);
	}
	return thickness;
}

vec3 materialBeerAttenuation(vec3 attenuationColor, float attenuationDistance, float distance, float transmissionStrength) {
	if (!(attenuationDistance > EPSILON) || !(distance > EPSILON) || transmissionStrength <= 0.001) {
		return vec3(1.0);
	}

	vec3 color = clamp(attenuationColor, vec3(0.0), vec3(1.0));
	vec3 absorption = exp(-(vec3(1.0) - color) * (distance / attenuationDistance));
	return mix(vec3(1.0), absorption, clamp(transmissionStrength, 0.0, 1.0));
}

bool materialIsUnlit(GpuMaterial material) {
	return material.textureInfo.w == MATERIAL_UNLIT;
}

vec3 transmissionTint(GpuMaterial material, vec3 albedo) {
	if (!materialIsTransmission(material)) {
		return albedo;
	}

	if (maxComponent(albedo) >= 0.05) {
		return albedo;
	}

	float alphaHint = clamp(material.baseColor.a, 0.0, 1.0);
	float tintFloor = clamp(0.35 + (1.0 - alphaHint) * 0.5, 0.35, 0.85);
	return max(albedo, vec3(tintFloor));
}

bool alphaCoverageAccepted(float alpha, uint triIdx, float hitU, float hitV) {
	uint uBits = floatBitsToUint(hitU);
	uint vBits = floatBitsToUint(hitV);
	uint seed =
		triIdx ^
		pcgHash(pc.sampleIndex + 0x9E3779B9u) ^
		pcgHash(uBits ^ (vBits * 1664525u));
	float threshold = float(pcgHash(seed) >> 8u) * (1.0 / 16777216.0);
	return alpha > 0.0 && alpha >= threshold;
}

bool alphaHitAccepted(uint triIdx, float hitU, float hitV) {
	GpuTriShading shading = triShading[triIdx];
	uint materialIndex = shading.ids.x;
	if (materialIndex >= pc.sceneCounts.z) {
		return true;
	}

	GpuMaterial material = materials[materialIndex];
	uint alphaMode = material.textureInfo.y;
	if (alphaMode == GLTF_ALPHA_OPAQUE) {
		return true;
	}

	vec2 uv = interpolateUv(shading, hitU, hitV);
	float alpha = materialAlpha(material, uv);
	if (alphaMode == GLTF_ALPHA_MASK) {
		return alpha >= material.textureParams.x;
	}

	return alphaCoverageAccepted(alpha, triIdx, hitU, hitV);
}

bool rayAabb(vec3 origin, vec3 invDir, vec3 boxMin, vec3 boxMax, float maxT) {
	vec3 t0 = (boxMin - origin) * invDir;
	vec3 t1 = (boxMax - origin) * invDir;
	vec3 tSmall = min(t0, t1);
	vec3 tBig = max(t0, t1);
	float tmin = max(max(tSmall.x, tSmall.y), max(tSmall.z, 0.0));
	float tmax = min(min(tBig.x, tBig.y), min(tBig.z, maxT));
	return tmax >= tmin;
}

float rayBias() {
	return max(pc.cameraParams.z, MIN_RAY_BIAS);
}

float triangleDetEpsilon(GpuTriIntersect tri) {
	if (invalidVec3(tri.eA.xyz) || invalidVec3(tri.eB.xyz)) {
		return MIN_DET_EPSILON;
	}

	float edgeScaleSq = max(dot(tri.eA.xyz, tri.eA.xyz), dot(tri.eB.xyz, tri.eB.xyz));
	if (isnan(edgeScaleSq) || isinf(edgeScaleSq) || !(edgeScaleSq > 0.0)) {
		return MIN_DET_EPSILON;
	}

	return max(edgeScaleSq * 0.0000001, MIN_DET_EPSILON);
}

bool rayIntersectsTriangle(
	vec3 origin,
	vec3 dir,
	GpuTriIntersect tri,
	out float t,
	out float hitU,
	out float hitV
) {
	vec3 h = cross(dir, tri.eB.xyz);
	float det = dot(tri.eA.xyz, h);
	float detEpsilon = triangleDetEpsilon(tri);

	if (tri.ids.y != 0u) {
		if (abs(det) <= detEpsilon) {
			return false;
		}
	}
	else if (det <= detEpsilon) {
		return false;
	}

	float invDet = 1.0 / det;
	vec3 s = origin - tri.a.xyz;
	float u = invDet * dot(s, h);
	if (u < 0.0 || u > 1.0) {
		return false;
	}

	vec3 q = cross(s, tri.eA.xyz);
	float v = invDet * dot(dir, q);
	if (v < 0.0 || u + v > 1.0) {
		return false;
	}

	t = invDet * dot(tri.eB.xyz, q);
	if (t > EPSILON) {
		hitU = u;
		hitV = v;
		return true;
	}

	return false;
}

bool dirIsNegativeOnAxis(vec3 invDir, uint axis) {
	if (axis == 0u) {
		return invDir.x < 0.0;
	}
	if (axis == 1u) {
		return invDir.y < 0.0;
	}
	return invDir.z < 0.0;
}

bool traverseBvh(
	vec3 origin,
	vec3 dir,
	vec3 invDir,
	out uint hitTriIdx,
	out float closestT,
	out float hitU,
	out float hitV,
	out bool stackOverflow
) {
	hitTriIdx = 0u;
	closestT = INF_T;
	hitU = 0.0;
	hitV = 0.0;
	stackOverflow = false;

	uint bvhCount = pc.sceneCounts.y;
	uint triCount = pc.sceneCounts.x;
	if (bvhCount == 0u || triCount == 0u) {
		return false;
	}

	uint stack[BVH_MAX_STACK_DEPTH];
	int stackPtr = 0;
	uint current = 0u;
	bool hit = false;

	while (true) {
		if (current >= bvhCount) {
			stackOverflow = true;
			break;
		}

		GpuBvhNode node = bvhNodes[current];
		if (rayAabb(origin, invDir, node.minBounds.xyz, node.maxBounds.xyz, closestT)) {
			uint triStart = node.meta.x;
			uint triNodeCount = node.meta.y;
			if (triNodeCount > 0u) {
				for (uint i = 0u; i < triNodeCount; ++i) {
					uint triBufferIndex = triStart + i;
					if (triBufferIndex >= triCount) {
						continue;
					}

					float t;
					float u;
					float v;
					GpuTriIntersect tri = triIsect[triBufferIndex];
					if (rayIntersectsTriangle(origin, dir, tri, t, u, v) && t < closestT) {
						if (tri.ids.x >= triCount || !alphaHitAccepted(tri.ids.x, u, v)) {
							continue;
						}
						closestT = t;
						hitTriIdx = tri.ids.x;
						hitU = u;
						hitV = v;
						hit = true;
					}
				}

				if (stackPtr == 0) {
					break;
				}
				current = stack[--stackPtr];
			}
			else {
				uint firstChild = current + 1u;
				uint secondChild = node.meta.x;
				if (stackPtr >= BVH_MAX_STACK_DEPTH) {
					stackOverflow = true;
					break;
				}

				if (dirIsNegativeOnAxis(invDir, node.meta.z)) {
					stack[stackPtr++] = firstChild;
					current = secondChild;
				}
				else {
					stack[stackPtr++] = secondChild;
					current = firstChild;
				}
			}
		}
		else {
			if (stackPtr == 0) {
				break;
			}
			current = stack[--stackPtr];
		}
	}

	return hit && hitTriIdx < triCount;
}

vec3 rayTracedShadowVisibility(vec3 hitPos, vec3 normal, vec3 lightDir) {
	float bias = rayBias();
	vec3 shadowOrigin = hitPos + normal * bias;
	vec3 invLightDir = 1.0 / lightDir;
	vec3 visibility = vec3(1.0);

	for (int i = 0; i < 8; ++i) {
		uint hitTriIdx;
		float closestT;
		float hitU;
		float hitV;
		bool stackOverflow;
		bool hit = traverseBvh(shadowOrigin, lightDir, invLightDir, hitTriIdx, closestT, hitU, hitV, stackOverflow);
		if (stackOverflow || !hit) {
			return visibility;
		}

		GpuTriShading shading = triShading[hitTriIdx];
		uint materialIndex = shading.ids.x;
		if (materialIndex >= pc.sceneCounts.z) {
			return vec3(0.0);
		}

		vec2 hitUv = interpolateUv(shading, hitU, hitV);
		GpuMaterial material = materials[materialIndex];
		float transmission = materialTransmissionStrength(material, hitUv);
		if (transmission <= 0.001) {
			return vec3(0.0);
		}

		visibility *= vec3(transmission);
		float thickness = materialVolumeThickness(material, hitUv);
		if (thickness > 0.001) {
			visibility *= materialBeerAttenuation(material.attenuation.rgb, material.attenuation.a, thickness, transmission);
		}
		if (maxComponent(visibility) <= 0.01) {
			return vec3(0.0);
		}

		shadowOrigin += lightDir * (closestT + bias);
	}

	return visibility;
}

bool projectShadowMap(vec3 worldPos, out vec2 uv, out float depth) {
	float lightX = dot(worldPos, cfg.shadowBasisX.xyz);
	float lightY = dot(worldPos, cfg.shadowBasisY.xyz);
	uv = (vec2(lightX, lightY) - cfg.shadowBounds.xy) * cfg.shadowBounds.zw;
	if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
		return false;
	}

	depth = (cfg.shadowDepth.x - dot(worldPos, cfg.shadowBasisZ.xyz)) * cfg.shadowDepth.y;
	return depth >= 0.0 && depth <= 1.0;
}

float unpackShadowDepth(uint packedDepth) {
	if (packedDepth == SHADOW_MAP_EMPTY) {
		return 1.0;
	}
	return float(packedDepth) * (1.0 / 4294967294.0);
}

vec3 shadowMapVisibility(vec3 hitPos, vec3 normal, vec3 lightDir) {
	uint mapSize = max(1u, uint(cfg.shadowParams.y + 0.5));
	vec2 uv;
	float receiverDepth;
	vec3 samplePos = hitPos + normal * cfg.shadowDepth.w;
	if (!projectShadowMap(samplePos, uv, receiverDepth)) {
		return vec3(1.0);
	}

	ivec2 baseTexel = ivec2(floor(uv * float(mapSize)));
	float slopeBias = cfg.shadowDepth.z * (1.0 + 3.0 * (1.0 - clamp(dot(normal, lightDir), 0.0, 1.0)));
	float visibility = 0.0;
	float sampleCount = 0.0;
	for (int y = -1; y <= 1; ++y) {
		for (int x = -1; x <= 1; ++x) {
			ivec2 texel = baseTexel + ivec2(x, y);
			if (texel.x < 0 || texel.y < 0 || texel.x >= int(mapSize) || texel.y >= int(mapSize)) {
				visibility += 1.0;
				sampleCount += 1.0;
				continue;
			}

			uint shadowIndex = uint(texel.y) * mapSize + uint(texel.x);
			uint storedPacked = shadowMap[shadowIndex];
			if (storedPacked == SHADOW_MAP_EMPTY) {
				visibility += 1.0;
			}
			else {
				float storedDepth = unpackShadowDepth(storedPacked);
				visibility += storedDepth + slopeBias >= receiverDepth ? 1.0 : 0.0;
			}
			sampleCount += 1.0;
		}
	}

	return vec3(sampleCount > 0.0 ? visibility / sampleCount : 1.0);
}

vec3 directSunVisibility(vec3 hitPos, vec3 normal, vec3 lightDir) {
	uint shadowMode = uint(cfg.shadowParams.x + 0.5);
	if (shadowMode == SHADOW_MODE_RAY_TRACED) {
		return rayTracedShadowVisibility(hitPos, normal, lightDir);
	}
	if (shadowMode == SHADOW_MODE_SHADOW_MAP) {
		return shadowMapVisibility(hitPos, normal, lightDir);
	}
	return vec3(1.0);
}

vec3 directSunLighting(vec3 hitPos, vec3 normal, vec3 albedo, float metalness) {
	vec3 lightDir = safeNormalize(cfg.sunDir.xyz, vec3(0.0, 0.0, 1.0));
	float nDotL = max(dot(normal, lightDir), 0.0);
	if (nDotL <= 0.0) {
		return vec3(0.0);
	}

	vec3 visibility = directSunVisibility(hitPos, normal, lightDir);
	float sunAngularRadius = radians(max(cfg.sunDir.w, 0.01));
	float sunSolidAngle = 2.0 * PI * (1.0 - cos(sunAngularRadius));
	vec3 diffuseAlbedo = albedo * (1.0 - clamp(metalness, 0.0, 1.0));
	return diffuseAlbedo * cfg.sunColor.rgb * cfg.sunColor.w * (sunSolidAngle / PI) * nDotL * visibility;
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= pc.width || pixel.y >= pc.height) {
		return;
	}

	uint pixelIndex = uint(pixel.y * pc.width + pixel.x);
	uint rng = seedRng(pixelIndex, pc.sampleIndex);

	vec2 jitter = vec2(rngFloat(rng), rngFloat(rng));
	vec2 uv = (vec2(pixel) + jitter) / vec2(pc.width, pc.height);
	float verticalScale = pc.cameraParams.x;
	float aspect = pc.cameraParams.y;
	vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	vec3 origin = pc.cameraPos.xyz;
	vec3 dir = safeNormalize(
		pc.cameraForward.xyz +
		pc.cameraRight.xyz * ndc.x * aspect * verticalScale +
		pc.cameraUp.xyz * ndc.y * verticalScale,
		pc.cameraForward.xyz
	);
	vec3 invDir = 1.0 / dir;

	vec3 radiance = vec3(0.0);
	vec3 throughput = vec3(1.0);
	bool firstHitRecorded = false;
	vec3 firstHitNormal = vec3(0.0);
	vec3 firstHitAlbedo = vec3(0.0);
	float firstHitRoughness = 1.0;
	float firstHitMetalness = 0.0;
	float firstHitDepth = 0.0;
	uint firstHitMaterialId = INVALID_ID;
	uint firstHitInstanceId = INVALID_ID;
	int maxBounces = max(0, int(cfg.renderParams.x + 0.5));
	int rrMinBounces = max(0, int(cfg.renderParams.y + 0.5));
	bool useRussianRoulette = cfg.renderParams.z > 0.5;
	bool insideVolumeMedium = false;
	float mediumIor = 1.0;
	vec3 mediumAttenuationColor = vec3(1.0);
	float mediumAttenuationDistance = 0.0;
	float mediumTransmission = 0.0;
	float mediumFallbackThickness = 0.0;
	uint mediumMaterialId = INVALID_ID;

	for (int bounce = 0; bounce <= maxBounces; ++bounce) {
		uint hitTriIdx;
		float closestT;
		float hitU;
		float hitV;
		bool stackOverflow;
		bool hit = traverseBvh(origin, dir, invDir, hitTriIdx, closestT, hitU, hitV, stackOverflow);

		if (stackOverflow) {
			if (insideVolumeMedium) {
				throughput *= materialBeerAttenuation(
					mediumAttenuationColor,
					mediumAttenuationDistance,
					max(mediumFallbackThickness, 0.0),
					mediumTransmission
				);
			}
			radiance += throughput * sky(dir);
			break;
		}

		if (!hit) {
			if (insideVolumeMedium) {
				throughput *= materialBeerAttenuation(
					mediumAttenuationColor,
					mediumAttenuationDistance,
					max(mediumFallbackThickness, 0.0),
					mediumTransmission
				);
			}
			radiance += throughput * sky(dir);
			break;
		}

		GpuTriIntersect hitTri = triIsect[hitTriIdx];
		GpuTriShading shading = triShading[hitTriIdx];
		float hitW = 1.0 - hitU - hitV;
		vec3 geometricNormal = safeNormalize(cross(hitTri.eA.xyz, hitTri.eB.xyz), -dir);
		bool frontFace = dot(dir, geometricNormal) < 0.0;
		vec3 faceNormal = frontFace ? geometricNormal : -geometricNormal;
		vec3 normal = safeNormalize(shading.aN.xyz * hitW + shading.bN.xyz * hitU + shading.cN.xyz * hitV, faceNormal);
		if (dot(normal, -dir) < 0.0) {
			normal = -normal;
		}
		vec2 hitUv = interpolateUv(shading, hitU, hitV);

		uint materialIndex = shading.ids.x;
		vec3 albedo = vec3(0.8);
		float roughness = 0.5;
		float metalness = 0.0;
		float emissionIntensity = 0.0;
		vec3 emissionColor = vec3(0.0);
		float ior = 1.5;
		float transmissionStrength = 0.0;
		float volumeThickness = 0.0;
		vec3 attenuationColor = vec3(1.0);
		float attenuationDistance = 0.0;
		bool thinTransmission = false;
		bool volumeTransmission = false;
		bool unlitMaterial = false;
		if (materialIndex < pc.sceneCounts.z) {
			GpuMaterial material = materials[materialIndex];
			vec4 baseColor = material.baseColor;
			if (validTexture(material.textureIndices.x)) {
				vec4 baseSample = sampleSceneTexture(material.textureIndices.x, hitUv, vec4(1.0));
				baseColor *= vec4(srgbToLinear(baseSample.rgb), baseSample.a);
			}
			albedo = max(baseColor.rgb, vec3(0.0));
			albedo = transmissionTint(material, albedo);
			roughness = clamp(material.params.x, 0.02, 1.0);
			metalness = clamp(material.params.y, 0.0, 1.0);
			if (validTexture(material.textureIndices.y)) {
				vec4 mrSample = sampleSceneTexture(material.textureIndices.y, hitUv, vec4(1.0));
				roughness = clamp(roughness * mrSample.g, 0.02, 1.0);
				metalness = clamp(metalness * mrSample.b, 0.0, 1.0);
			}
			emissionIntensity = max(material.params.z, 0.0);
			emissionColor = max(material.emissionIor.rgb, vec3(0.0));
			if (validTexture(material.textureIndices.w)) {
				vec3 emissiveSample = srgbToLinear(sampleSceneTexture(material.textureIndices.w, hitUv, vec4(1.0)).rgb);
				emissionColor *= emissiveSample;
			}
			ior = max(material.emissionIor.a, 1.001);
			transmissionStrength = materialTransmissionStrength(material, hitUv);
			thinTransmission = materialIsThinTransmission(material);
			volumeThickness = materialVolumeThickness(material, hitUv);
			volumeTransmission = materialIsVolumeTransmission(material) && volumeThickness > 0.001;
			if (materialIsVolumeTransmission(material) && !volumeTransmission) {
				thinTransmission = true;
			}
			attenuationColor = material.attenuation.rgb;
			attenuationDistance = material.attenuation.a;
			unlitMaterial = materialIsUnlit(material);

			if (validTexture(material.textureIndices.z)) {
				vec3 tangentSample = sampleSceneTexture(material.textureIndices.z, hitUv, vec4(0.5, 0.5, 1.0, 1.0)).rgb * 2.0 - 1.0;
				tangentSample.xy *= material.textureParams.y;
				tangentSample = safeNormalize(tangentSample, vec3(0.0, 0.0, 1.0));

				vec4 tangent4 = interpolateTangent(shading, hitU, hitV);
				vec3 tangent = tangent4.xyz - normal * dot(normal, tangent4.xyz);
				tangent = safeNormalize(tangent, abs(normal.z) < 0.999 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0));
				vec3 bitangent = safeNormalize(cross(normal, tangent) * tangent4.w, cross(normal, tangent));
				normal = safeNormalize(
					tangent * tangentSample.x +
					bitangent * tangentSample.y +
					normal * tangentSample.z,
					normal
				);
				if (dot(normal, -dir) < 0.0) {
					normal = -normal;
				}
			}
		}

		vec3 hitPos = origin + dir * closestT;
		if (insideVolumeMedium) {
			throughput *= materialBeerAttenuation(
				mediumAttenuationColor,
				mediumAttenuationDistance,
				closestT,
				mediumTransmission
			);
			if (invalidVec3(throughput) || maxComponent(throughput) <= 0.000001) {
				break;
			}
		}

		if (!firstHitRecorded) {
			firstHitRecorded = true;
			firstHitNormal = normal;
			firstHitAlbedo = albedo;
			firstHitRoughness = roughness;
			firstHitMetalness = metalness;
			firstHitDepth = closestT;
			firstHitMaterialId = materialIndex < pc.sceneCounts.z ? materialIndex : INVALID_ID;
			firstHitInstanceId = shading.ids.y;
		}

		if (unlitMaterial) {
			radiance += throughput * max(albedo + emissionColor * emissionIntensity, vec3(0.0));
			break;
		}

		if (emissionIntensity > 0.0 && maxComponent(emissionColor) > 0.0) {
			radiance += throughput * emissionColor * emissionIntensity;
		}

		vec3 directSun = directSunLighting(hitPos, normal, albedo, metalness) *
			clamp(1.0 - transmissionStrength, 0.0, 1.0);
		if (maxComponent(directSun) > 0.0) {
			radiance += throughput * directSun;
		}

		vec3 microfacetNormal = sampleGGX(normal, roughness, rngFloat(rng), rngFloat(rng));
		float etaIncident = insideVolumeMedium ? mediumIor : 1.0;
		float etaTransmitted = ior;
		if (volumeTransmission) {
			etaIncident = insideVolumeMedium ? mediumIor : (frontFace ? 1.0 : ior);
			etaTransmitted = frontFace ? ior : 1.0;
		}
		float r0Dielectric = (etaIncident - etaTransmitted) / (etaIncident + etaTransmitted);
		r0Dielectric *= r0Dielectric;
		float r0 = mix(r0Dielectric, 1.0, metalness);
		float cosThetaI = clamp(-dot(dir, microfacetNormal), 0.0, 1.0);
		float rTheta = r0 + (1.0 - r0) * pow(1.0 - cosThetaI, 5.0);
		float transmissionProbability = transmissionStrength * (1.0 - rTheta);

		bool isSpecular = false;
		bool isTransmission = false;
		vec3 nextDir = normal;
		float eventSample = rngFloat(rng);
		if (eventSample <= rTheta) {
			vec3 reflectedDir = safeNormalize(reflect(dir, microfacetNormal), normal);
			if (dot(reflectedDir, normal) > 0.0 && dot(reflectedDir, faceNormal) > 0.0) {
				nextDir = reflectedDir;
				isSpecular = true;
			}
		}
		else if (eventSample <= rTheta + transmissionProbability) {
			if (thinTransmission) {
				nextDir = dir;
				isTransmission = true;
			}
			else {
				float eta1 = insideVolumeMedium ? mediumIor : (frontFace ? 1.0 : ior);
				float eta2 = frontFace ? ior : 1.0;
				float eta = eta1 / max(eta2, 1.0);
				vec3 refractedDir = refract(dir, normal, eta);
				if (!invalidVec3(refractedDir) && dot(refractedDir, refractedDir) > EPSILON) {
					nextDir = safeNormalize(refractedDir, dir);
					isTransmission = true;
				}
				else {
					nextDir = safeNormalize(reflect(dir, microfacetNormal), faceNormal);
					isSpecular = true;
				}
			}
		}

		if (isSpecular) {
			throughput *= mix(vec3(1.0), albedo, metalness);
		}
		else if (isTransmission) {
			throughput *= mix(vec3(1.0), albedo, 1.0 - metalness);
			if (volumeTransmission) {
				if (frontFace) {
					insideVolumeMedium = true;
					mediumIor = ior;
					mediumAttenuationColor = attenuationColor;
					mediumAttenuationDistance = attenuationDistance;
					mediumTransmission = transmissionStrength;
					mediumFallbackThickness = volumeThickness;
					mediumMaterialId = materialIndex;
				}
				else if (insideVolumeMedium) {
					insideVolumeMedium = false;
					mediumIor = 1.0;
					mediumAttenuationColor = vec3(1.0);
					mediumAttenuationDistance = 0.0;
					mediumTransmission = 0.0;
					mediumFallbackThickness = 0.0;
					mediumMaterialId = INVALID_ID;
				}
			}
		}
		else {
			throughput *= albedo;
			nextDir = sampleCosineHemisphere(normal, faceNormal, rngFloat(rng), rngFloat(rng));
		}

		if (invalidVec3(throughput) || maxComponent(throughput) <= 0.000001) {
			break;
		}

		vec3 originBiasDir = faceNormal;
		if (isTransmission) {
			originBiasDir = thinTransmission ? nextDir : -faceNormal;
		}
		origin = hitPos + originBiasDir * rayBias();
		dir = safeNormalize(nextDir, normal);
		invDir = 1.0 / dir;

		if (useRussianRoulette && bounce >= rrMinBounces) {
			float pSurvive = clamp(maxComponent(throughput), 0.05, 1.0);
			if (rngFloat(rng) > pSurvive) {
				break;
			}
			throughput /= pSurvive;
		}
	}

	if (invalidVec3(radiance)) {
		radiance = vec3(1.0, 0.0, 1.0);
	}

	vec3 sum = accum[pixelIndex].rgb + radiance;
	accum[pixelIndex] = vec4(sum, 1.0);

	vec3 color = sum / float(pc.sampleIndex + 1u);
	imageStore(resolvedHdrImage, pixel, vec4(color, 1.0));
	imageStore(normalRoughnessImage, pixel, vec4(firstHitNormal, firstHitRoughness));
	imageStore(albedoMetallicImage, pixel, vec4(firstHitAlbedo, firstHitMetalness));
	imageStore(depthImage, pixel, vec4(firstHitDepth, 0.0, 0.0, 0.0));
	imageStore(materialIdImage, pixel, uvec4(firstHitMaterialId, 0u, 0u, 0u));
	imageStore(instanceIdImage, pixel, uvec4(firstHitInstanceId, 0u, 0u, 0u));

	color *= cfg.renderParams.w;
	color = clamp(color, 0.0, 1.0);
	color = contrastSCurve(color, cfg.skyParams.w);
	color = pow(max(color, vec3(0.0)), vec3(1.0 / 2.2));
	pixels[pixelIndex] = packRgba(color);
}
