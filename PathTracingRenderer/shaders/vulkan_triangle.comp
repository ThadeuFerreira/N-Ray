#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) buffer PixelBuffer {
	uint pixels[];
};

layout(push_constant) uniform PushConstants {
	int width;
	int height;
	float time;
	float _padding0;
} pc;

float edge(vec2 a, vec2 b, vec2 p) {
	return (p.x - a.x) * (b.y - a.y) - (p.y - a.y) * (b.x - a.x);
}

uint packRgba(vec3 color) {
	uvec3 rgb = uvec3(clamp(color, 0.0, 1.0) * 255.0 + 0.5);
	return rgb.r | (rgb.g << 8) | (rgb.b << 16) | (255u << 24);
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= pc.width || pixel.y >= pc.height) {
		return;
	}

	vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(pc.width, pc.height);
	vec2 p = vec2(uv.x * 2.0 - 1.0, (1.0 - uv.y) * 2.0 - 1.0);
	p.x *= float(pc.width) / float(pc.height);

	vec2 a = vec2(0.0, 0.68);
	vec2 b = vec2(-0.78, -0.58);
	vec2 c = vec2(0.78, -0.58);

	float area = edge(a, b, c);
	float wa = edge(b, c, p) / area;
	float wb = edge(c, a, p) / area;
	float wc = edge(a, b, p) / area;

	vec3 background = mix(vec3(0.02, 0.025, 0.04), vec3(0.10, 0.13, 0.18), uv.y);
	background += 0.03 * vec3(sin(pc.time + uv.x * 8.0), sin(pc.time * 0.8 + uv.y * 6.0), 1.0);

	vec3 color = background;
	if (wa >= 0.0 && wb >= 0.0 && wc >= 0.0) {
		vec3 baryColor = wa * vec3(1.0, 0.18, 0.12) + wb * vec3(0.10, 0.9, 0.32) + wc * vec3(0.12, 0.35, 1.0);
		color = baryColor;
	}

	uint index = uint(pixel.y * pc.width + pixel.x);
	pixels[index] = packRgba(color);
}
